  "search_evidence": {
   "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
   },
   "description": "Find portfolio evidence (case studies, repos, reviews, past proposals) proving ONE job\n    requirement, e.g. \"hybrid search with exact product codes\". Returns up to k items with\n    id, type, source, date and outcome. Call once per requirement; cite results as [id].",
   "input": {
    "$defs": {
     "EvidenceFilters": {
      "properties": {
       "client_industry": {
        "anyOf": [
         {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         {
          "type": "null"
         }
        ],
        "default": null,
        "description": "e.g. ['fintech', 'SaaS']",
        "title": "Client Industry"
       },
       "outcome": {
        "anyOf": [
         {
          "items": {
           "enum": [
            "won",
            "replied",
            "ignored"
           ],
           "type": "string"
          },
          "type": "array"
         },
         {
          "type": "null"
         }
        ],
        "default": null,
        "description": "past proposals only: outcomes to keep",
        "title": "Outcome"
       },
       "since": {
        "anyOf": [
         {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "default": null,
        "description": "ISO date; evidence on/after it",
        "title": "Since"
       },
       "skills": {
        "anyOf": [
         {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         {
          "type": "null"
         }
        ],
        "default": null,
        "description": "evidence must mention at least one of these skills",
        "title": "Skills"
       },
       "type": {
        "anyOf": [
         {
          "items": {
           "enum": [
            "case_study",
            "repo",
            "review",
            "proposal",
            "cv",
            "upload"
           ],
           "type": "string"
          },
          "type": "array"
         },
         {
          "type": "null"
         }
        ],
        "default": null,
        "description": "only these evidence types",
        "title": "Type"
       }
      },
      "title": "EvidenceFilters",
      "type": "object"
     }
    },
    "properties": {
     "filters": {
      "anyOf": [
       {
        "$ref": "#/$defs/EvidenceFilters"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     },
     "k": {
      "default": 5,
      "title": "K",
      "type": "integer"
     },
     "requirement": {
      "title": "Requirement",
      "type": "string"
     }
    },
    "required": [
     "requirement"
    ],
    "title": "search_evidenceArguments",
    "type": "object"
   },
   "output": {
    "$defs": {
     "EvidenceItem": {
      "properties": {
       "client_industry": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "default": null,
        "title": "Client Industry"
       },
       "date": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "title": "Date"
       },
       "id": {
        "description": "evidence id, cite it as [id] in proposals",
        "title": "Id",
        "type": "string"
       },
       "matched_requirements": {
        "default": [],
        "items": {
         "type": "string"
        },
        "title": "Matched Requirements",
        "type": "array"
       },
       "outcome": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "default": null,
        "description": "won | replied | ignored (past proposals only)",
        "title": "Outcome"
       },
       "project": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "title": "Project"
       },
       "score": {
        "title": "Score",
        "type": "number"
       },
       "snippet": {
        "title": "Snippet",
        "type": "string"
       },
       "source": {
        "description": "file or repo the evidence comes from",
        "title": "Source",
        "type": "string"
       },
       "title": {
        "title": "Title",
        "type": "string"
       },
       "type": {
        "title": "Type",
        "type": "string"
       }
      },
      "required": [
       "id",
       "type",
       "title",
       "source",
       "date",
       "project",
       "snippet",
       "score"
      ],
      "title": "EvidenceItem",
      "type": "object"
     }
    },
    "properties": {
