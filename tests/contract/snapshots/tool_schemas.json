{
 "gigbid-marketplace": {
  "__prompts__": [],
  "__resource_templates__": [],
  "create_proposal_draft": {
   "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": false
   },
   "description": "Create a proposal DRAFT for a job (spends no Connects). Only call after the human approved\n    the text. Replays with the same idempotency_key return the original draft.",
   "input": {
    "$defs": {
     "CreateDraftInput": {
      "properties": {
       "dry_run": {
        "default": false,
        "description": "true: return what would be created without creating it",
        "title": "Dry Run",
        "type": "boolean"
       },
       "idempotency_key": {
        "description": "stable key for this exact draft, e.g. '<thread_id>:v<version>'",
        "maxLength": 128,
        "minLength": 8,
        "pattern": "^[A-Za-z0-9:_\\-.]+$",
        "title": "Idempotency Key",
        "type": "string"
       },
       "proposal": {
        "$ref": "#/$defs/ProposalPayload"
       }
      },
      "required": [
       "proposal",
       "idempotency_key"
      ],
      "title": "CreateDraftInput",
      "type": "object"
     },
     "ProposalPayload": {
      "properties": {
       "bid_amount": {
        "exclusiveMinimum": 0,
        "maximum": 1000000,
        "title": "Bid Amount",
        "type": "number"
       },
       "bid_unit": {
        "default": "fixed",
        "enum": [
         "fixed",
         "hourly"
        ],
        "title": "Bid Unit",
        "type": "string"
       },
       "cover_letter": {
        "maxLength": 5000,
        "minLength": 50,
        "title": "Cover Letter",
        "type": "string"
       },
       "job_id": {
        "title": "Job Id",
        "type": "string"
       },
       "screening_answers": {
        "items": {
         "additionalProperties": {
          "type": "string"
         },
         "type": "object"
        },
        "maxItems": 10,
        "title": "Screening Answers",
        "type": "array"
       }
      },
      "required": [
       "job_id",
       "cover_letter",
       "bid_amount"
      ],
      "title": "ProposalPayload",
      "type": "object"
     }
    },
    "properties": {
     "inp": {
      "$ref": "#/$defs/CreateDraftInput"
     }
    },
    "required": [
     "inp"
    ],
    "title": "create_proposal_draftArguments",
    "type": "object"
   },
   "output": {
    "$defs": {
     "DraftResult": {
      "properties": {
       "job_id": {
        "title": "Job Id",
        "type": "string"
       },
       "proposal_id": {
        "title": "Proposal Id",
        "type": "string"
       },
       "status": {
        "title": "Status",
        "type": "string"
       }
      },
      "required": [
       "proposal_id",
       "status",
       "job_id"
      ],
      "title": "DraftResult",
      "type": "object"
     }
    },
    "properties": {
     "draft": {
      "anyOf": [
       {
        "$ref": "#/$defs/DraftResult"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     },
     "dry_run": {
      "title": "Dry Run",
      "type": "boolean"
     },
     "replayed": {
      "default": false,
      "title": "Replayed",
      "type": "boolean"
     },
     "would_send": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Would Send"
     }
    },
    "required": [
     "dry_run"
    ],
    "title": "DraftOutput",
    "type": "object"
   }
  },
