# ---- App ----
APP_ENV=development
APP_SECRET_KEY=            # random 64-char string (JWT signing)
TOKEN_ENCRYPTION_KEY=      # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
REVIEWER_EMAIL=reviewer@gigbid.dev
REVIEWER_PASSWORD=         # set at deploy time, share privately with grader

# ---- Data stores ----
DATABASE_URL=postgresql://gigbid:gigbid@localhost:5432/gigbid
REDIS_URL=redis://localhost:6379/0

# ---- Marketplace ----
MARKETPLACE_MODE=gigsim    # gigsim | upwork_live
GIGSIM_BASE_URL=http://localhost:8081
GIGSIM_API_TOKEN=          # any random string; GigSim and GigBid must match
GIGSIM_ADMIN_TOKEN=        # simulator control (advance clock, policy version)
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
UPWORK_OAUTH_CLIENT_ID=
UPWORK_OAUTH_CLIENT_SECRET=
UPWORK_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/upwork/callback

# ---- MCP servers (bearer tokens for HTTP transport) ----
PORTFOLIO_MCP_URL=http://localhost:8091/mcp
MARKETPLACE_MCP_URL=http://localhost:8092/mcp
WORKSPACE_MCP_URL=http://localhost:8093/mcp
MCP_BEARER_TOKEN=          # random string shared by API/worker and MCP servers
GITHUB_PERSONAL_ACCESS_TOKEN=   # read-only fine-grained PAT for GitHub MCP

# ---- Models (open-weight only; free tiers) ----
MODEL_PROFILE=open         # open (Groq hosted) | open_local (Ollama)
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---- Tracing ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
