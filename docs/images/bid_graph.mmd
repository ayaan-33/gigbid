---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	ingest(ingest)
	job_analyst(job_analyst)
	risk_assessor(risk_assessor)
	fit_matcher(fit_matcher)
	decide(decide<hr/><small><em>defer = True</em></small>)
	pricing(pricing)
	not_worth(not_worth)
	writer(writer)
	verifier(verifier)
	critic(critic)
	compliance(compliance)
	mark_awaiting(mark_awaiting)
	approval_gate(approval_gate)
	apply_edit(apply_edit)
	submit(submit)
	__end__([<p>__end__</p>]):::last
	__start__ --> ingest;
	apply_edit -.-> __end__;
	apply_edit -.-> compliance;
	approval_gate -.-> __end__;
	approval_gate -.-> apply_edit;
	approval_gate -.-> submit;
	compliance -.-> __end__;
	compliance -. &nbsp;approval_gate&nbsp; .-> mark_awaiting;
	compliance -.-> submit;
	critic -.-> __end__;
	critic -.-> compliance;
	critic -.-> writer;
	decide -.-> __end__;
	decide -.-> pricing;
	fit_matcher --> decide;
	ingest -.-> __end__;
	ingest -.-> fit_matcher;
	ingest -.-> job_analyst;
	ingest -.-> risk_assessor;
	job_analyst --> decide;
	mark_awaiting --> approval_gate;
	pricing -.-> __end__;
	pricing -.-> not_worth;
	pricing -.-> writer;
	risk_assessor --> decide;
	verifier -.-> __end__;
	verifier -.-> critic;
	writer -.-> __end__;
	writer -.-> verifier;
	not_worth --> __end__;
	submit --> __end__;
	approval_gate -.-> approval_gate;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
